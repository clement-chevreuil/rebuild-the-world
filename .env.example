# Copiez ce fichier en ".env" à la racine du repo et remplissez vos identifiants SMTP.
# Le fichier .env n'est jamais commité (voir .gitignore).

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-compte@example.com
SMTP_PASS=votre-mot-de-passe
MAIL_FROM=votre-compte@example.com
MAIL_TO=clement.chevreuil@outlook.com
